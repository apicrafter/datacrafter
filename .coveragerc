[run]
source = datacrafter
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */build/*
    */dist/*
    */datacrafter.egg-info/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    def __del__
    pass
precision = 2
show_missing = True
skip_covered = False
# Coverage floor. Set just below the current measured coverage so CI catches
# regressions; ratchet upward as coverage improves (target: 80%).
fail_under = 40
